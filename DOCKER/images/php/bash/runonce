#!/bin/bash
echo "OS ___________________________________________" > /var/log/php/$(hostname)_startup.log
hostname >> /var/log/php/$(hostname)_startup.log
grep '^PRETTY_NAME' /etc/os-release | cut -d '"' -f 2 >> /var/log/php/$(hostname)_startup.log 2>&1
uname -a >> /var/log/php/$(hostname)_startup.log 2>&1
echo "______________________________________________" >> /var/log/php/$(hostname)_startup.log
date >> /var/log/php/$(hostname)_startup.log
echo "PHP __________________________________________" >> /var/log/php/$(hostname)_startup.log
php -v >> /var/log/php/$(hostname)_startup.log
php -r "print_r(gd_info());" >> /var/log/php/$(hostname)_startup.log
php -m >> /var/log/php/$(hostname)_startup.log
echo "ENV __________________________________________" >> /var/log/php/$(hostname)_startup.log
printenv >> /var/log/php/$(hostname)_startup.log
echo "NET __________________________________________" >> /var/log/php/$(hostname)_startup.log
ip -4 -o addr show scope global | awk '{print $2":", $4}' >> /var/log/php/$(hostname)_startup.log 2>&1
echo "______________________________________________" >> /var/log/php/$(hostname)_startup.log
echo -e "supervisord: $(supervisord -v)" >> /var/log/php/$(hostname)_startup.log
cat /tmp/php_* > /var/log/php/$(hostname)_release.log 2>&1
rm -v /tmp/php_*
/usr/bin/supervisord -n -c /etc/supervisor/supervisord.conf